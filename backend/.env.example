# CORS: origins allowed to call the API (your Vite dev server)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Sandbox for running candidate code. "docker" is the only safe mode.
SANDBOX_MODE=docker
# IMG_PY=python:3.12-slim
# IMG_CPP=gcc:13
# IMG_JAVA=eclipse-temurin:21-jdk

# Optional server-side default LLM so users don't have to paste a key
# DEFAULT_LLM_PROVIDER=gemini
# DEFAULT_LLM_API_KEY=

# Override model names if your provider retires one
# LLM_MODEL_GEMINI=gemini-2.5-flash
# LLM_MODEL_OPENAI=gpt-4o-mini
# LLM_MODEL_GROQ=llama-3.3-70b-versatile
# LLM_MODEL_ANTHROPIC=claude-haiku-5-5

# Key used to encrypt saved API keys (auto-generated into .secret if unset)
# APP_SECRET=